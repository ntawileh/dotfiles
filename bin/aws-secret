#!/usr/local/bin/fish

set selected (
    aws secretsmanager list-secrets \
    | jq -r '.SecretList[] | [.Name, .ARN] | @tsv' \
    | fzf --delimiter='\t' --with-nth=1
)
set name (echo $selected | cut -f1)
set arn (echo $selected | cut -f2)
if test -n "$name"
    aws --region us-east-2 secretsmanager get-secret-value --secret-id $arn
end
